tmp/

# Git worktrees / local snapshots
.worktrees/
ui-branch-snapshots/

# Secrets and local configuration
.env
.env.*
!.env.example
*.local
*.secret
*.secrets
*.pem
*.key
id_rsa
id_rsa.*
credentials.xml
**/credentials.xml
local.properties

# Logs and runtime output
logs/
**/logs/
*.log
*.out.log
*.err.log
*.gz
nohup.out
stdout.log
stderr.log

# Java / Maven
target/
**/target/
.mvn/timing.properties

# Node / frontend
node_modules/
**/node_modules/
dist/
**/dist/
dist-gui/
**/dist-gui/
build/
**/build/
.vite/
**/.vite/
coverage/

